# Copy to .env and replace every value. Generate each password with:
#   openssl rand -hex 32
# Use URL-safe passwords: they're embedded in connection URLs.
POSTGRES_PASSWORD=change-me
LEDGER_APP_DB_PASSWORD=change-me
LEDGER_RELAY_DB_PASSWORD=change-me
LEDGER_RECONCILER_DB_PASSWORD=change-me

# Optional: local ports, bound to 127.0.0.1 only.
# LEDGER_POSTGRES_PORT=5432
# LEDGER_GATEWAY_PORT=3000
